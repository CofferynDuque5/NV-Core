# Copy to `.env` in the repo root to override docker-compose defaults.
# docker compose reads this automatically.

# Database
POSTGRES_USER=nvcore
POSTGRES_PASSWORD=nvcore
POSTGRES_DB=nvcore

# Auth — OBLIGATORIO. Genera valores únicos, nunca los reutilices:
#   JWT_SECRET:      openssl rand -base64 48      (mín. 16 chars)
#   ENCRYPTION_KEY:  openssl rand -hex 16         (exactamente 32 hex = 16 bytes; cifra tokens en reposo)
JWT_SECRET=
ENCRYPTION_KEY=

# Admin inicial OPCIONAL. Si defines ambos, se crea ese Owner al arrancar.
# Usa una contraseña fuerte y única — este archivo NO debe subirse a git.
# NV_ADMIN_EMAIL=tu-email@dominio.com
# NV_ADMIN_PASSWORD=
# NV_ADMIN_NAME=Tu Nombre

# URLs (defaults work for local compose)
CORS_ORIGINS=http://localhost:3000
VITE_API_URL=http://localhost:4000

# n8n como orquestador (opcional)
# Webhook de n8n al que el backend reenvía eventos de dominio:
# N8N_EVENTS_WEBHOOK=https://n8n.tu-dominio/webhook/nv-core-events
# Secreto que n8n debe enviar (X-N8N-Secret) para llamar a /api/automation/actions/*:
# N8N_INBOUND_SECRET=cambia-esto-por-un-secreto-largo
