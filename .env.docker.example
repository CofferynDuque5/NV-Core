# Copy to `.env` in the repo root to override docker-compose defaults.
# docker compose reads this automatically.

# Database
POSTGRES_USER=nvcore
POSTGRES_PASSWORD=nvcore
POSTGRES_DB=nvcore

# Auth — CHANGE THIS in any real deployment (min 16 chars)
JWT_SECRET=change-me-to-a-long-random-string-please

# URLs (defaults work for local compose)
CORS_ORIGINS=http://localhost:3000
VITE_API_URL=http://localhost:4000
