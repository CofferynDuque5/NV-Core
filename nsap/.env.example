# ─────────────────────────────────────────────────────────────────────────────
# NSAP · configuración de entorno
# Copia este archivo a ".env" y rellena lo que necesites:
#     cp .env.example .env
# TODO es opcional: sin claves, la app arranca igual y las funciones que
# requieran una integración avisan en vez de romperse (degradación limpia).
# Arranca con:  ./start.sh        (o  npm run dev  si defines las vars a mano)
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=4000
# URL pública de la app. IMPRESCINDIBLE para Instagram (IG exige URLs públicas
# del media). En local usa un túnel (ngrok/localtunnel) y pega aquí su URL.
# Para WhatsApp/Facebook no hace falta; puede quedarse en localhost.
APP_URL=http://localhost:4000

# ── Panel / seguridad ────────────────────────────────────────────────────────
# Admin inicial (solo se usa la 1ª vez para sembrar el usuario). Cámbialo luego
# desde la pestaña "Usuarios".
NSAP_USERNAME=admin
NSAP_PASSWORD=admin
# Secreto para firmar la cookie de sesión. DEFÍNELO con algo aleatorio en prod:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NSAP_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Token de máquina: peticiones con la cabecera "x-api-token: <token>" se
# autentican sin cookie (lo usa n8n). Déjalo vacío para desactivarlo.
NSAP_API_TOKEN=

# ── Almacenamiento / envíos ──────────────────────────────────────────────────
# NSAP_DATA_DIR=data
# NSAP_SESSION_DIR=data/session
# NSAP_UPLOAD_DIR=data/uploads
# Retardo (ms) entre grupos al enviar campañas (anti-bloqueo de WhatsApp).
NSAP_GROUP_DELAY_MS=4000
# Tamaño máximo de subida en MB (videos/Reels pueden ser grandes).
NSAP_MAX_UPLOAD_MB=200

# ── Facebook / Instagram (Meta Graph API) ────────────────────────────────────
# Publicar en FB/IG. Consíguelos en https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Página de Facebook + token de Página (permisos: pages_manage_posts,
# pages_read_engagement; usa un token de larga duración).
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Cuenta de Instagram Business vinculada a la Página (instagram_basic,
# instagram_content_publish). Si dejas IG_ACCESS_TOKEN vacío, usa FB_PAGE_TOKEN.
IG_BUSINESS_ID=
IG_ACCESS_TOKEN=

# ── IA (elige UNA) ───────────────────────────────────────────────────────────
# Para el botón "IA" que genera el texto de la campaña.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Opcional: fuerza el proveedor (openai | anthropic | gemini). Si no, se
# autodetecta según la clave definida.
AI_PROVIDER=

# ── n8n (opcional) ───────────────────────────────────────────────────────────
# El backend envía trabajos a n8n y recibe el resultado por callback.
# Define el webhook del workflow, O la base + el nombre del workflow al despachar.
N8N_WEBHOOK_URL=
# En docker-compose NSAP alcanza n8n en http://n8n:5678 (por defecto). Solo
# defínelo si usas un n8n externo.
N8N_BASE_URL=
N8N_API_KEY=
# Protege el callback público POST {APP_URL}/api/n8n/callback?token=...
N8N_CALLBACK_TOKEN=

# ── n8n en docker-compose (solo si levantas el servicio n8n) ──────────────────
# Login del panel de n8n (http://localhost:5678).
N8N_USER=admin
N8N_PASSWORD=changeme
# Puerto del host para n8n y datos de host/protocolo para sus webhooks.
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_BASE=http://localhost:5678/
# Zona horaria de n8n.
TZ=America/Mexico_City
