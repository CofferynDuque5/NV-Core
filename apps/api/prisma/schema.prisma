// NV Core — data model (PostgreSQL).
//
// Multi-tenant by slug: workspaces are configuration (see @nv/domain), so every
// operational row carries `workspaceSlug` (indexed) rather than a Workspace FK.
// Identity (User/Membership) is persisted here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelId {
  wa
  ig
  fb
  tk
  tg
  x
  th
  email
}

enum CampaignStatus {
  borrador
  programada
  activa
  pausada
  completada
}

enum PostStatus {
  draft
  scheduled
  publishing
  sent
  error
}

enum ConnectionStatus {
  ok
  warn
  down
}

enum Role {
  Owner
  Admin
  Editor
  Visor
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String
  passwordHash        String
  emailVerifiedAt     DateTime?
  /// Consecutive failed logins; reset to 0 on success. Drives account lockout.
  failedLoginAttempts Int            @default(0)
  /// When set and in the future, logins are refused (brute-force lockout).
  lockedUntil         DateTime?
  /// When the user accepted the legal terms, and which version (TERMS_VERSION).
  termsAcceptedAt     DateTime?
  termsVersion        String?
  /// Last successful sign-in, how many there were, and the last time the session was renewed.
  lastLoginAt         DateTime?
  loginCount          Int            @default(0)
  lastSeenAt          DateTime?
  /// The shared «Ver demo» account: read-only, hidden from customer counts.
  demo                Boolean        @default(false)
  createdAt           DateTime       @default(now())
  memberships         Membership[]
  refreshTokens       RefreshToken[]
  authTokens          AuthToken[]
  loginEvents         LoginEvent[]
}

/// One row per successful sign-in, for the super-admin «Usuarios» panel. Kept 90 days.
model LoginEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// "password" or "demo".
  method    String   @default("password")
  ip        String?
  userAgent String?
  at        DateTime @default(now())

  @@index([at])
  @@index([userId, at])
}

/**
 * Single-use tokens for password reset ("reset") and email verification ("verify").
 */
model AuthToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  purpose   String
  /// sha256 hash of the opaque token (never stored in clear).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// sha256 hash of the opaque refresh token (never stored in clear).
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Membership {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  workspaceSlug String
  role          Role     @default(Visor)
  createdAt     DateTime @default(now())

  @@unique([userId, workspaceSlug])
  @@index([workspaceSlug])
}

model Contact {
  id            String    @id @default(cuid())
  workspaceSlug String
  name          String
  phone         String?
  email         String?
  company       String?
  tags          String[]
  stage         String    @default("Lead")
  lastContactAt DateTime?
  /// When the contact asked not to receive automated messages (null = active).
  /// Sequences and automations never message an opted-out contact.
  optOutAt      DateTime?
  /// How the opt-out was recorded: "keyword" (they wrote BAJA/STOP) or "manual".
  optOutSource  String?
  /// When / how consent to receive messages was recorded (e.g. "form", "manual").
  consentAt     DateTime?
  consentSource String?
  /// First-touch origin (LeadAttribution) set by public forms and funnels.
  attribution   Json?
  createdAt     DateTime  @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
  @@index([workspaceSlug, lastContactAt])
}

model Group {
  id             String    @id @default(cuid())
  workspaceSlug  String
  name           String
  channel        ChannelId @default(wa)
  /// Destination kind: "group" (chat) or "channel" (broadcast, e.g. a Telegram
  /// channel where the bot is an admin). Delivery is the same; this drives UI.
  kind           String    @default("group")
  members        Int       @default(0)
  admins         Int       @default(0)
  description    String?
  tags           String[]
  /// WhatsApp number (line) that is in this group and sends to it.
  waLine         Int       @default(1)
  /// WhatsApp group JID (e.g. "12345-678@g.us") when synced from Baileys.
  remoteJid      String?
  /// True when the row was populated from a WhatsApp sync (vs. manual CRUD).
  synced         Boolean   @default(false)
  /// «Apartado»: campaigns never post here (team, university, news groups…).
  excluded       Boolean   @default(false)
  /// What the group is about (GROUP_CATEGORIES in @nv/domain).
  category       String?
  /// The group's rules ask for a price / a photo in every post.
  requiresPrice  Boolean   @default(false)
  requiresImage  Boolean   @default(false)
  /// The group's rules ban ads; only admins can write (WhatsApp setting).
  forbidsAds     Boolean   @default(false)
  onlyAdmins     Boolean   @default(false)
  /// ISO country chosen by the user; when null it is detected (name, creator).
  country        String?
  /// Creator of the WhatsApp group, read on sync (its prefix hints the country).
  ownerJid       String?
  /// Last time the rules were read and checked.
  rulesCheckedAt DateTime?
  createdAt      DateTime  @default(now())

  variables       GroupVariable[]
  campaignTargets CampaignTarget[]
  sendLogs        SendLog[]

  @@unique([workspaceSlug, remoteJid])
  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

/**
 * Per-group merge variables: {{key}} → value when rendering campaign messages.
 */
model GroupVariable {
  id            String   @id @default(cuid())
  workspaceSlug String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String
  key           String
  value         String   @default("")
  createdAt     DateTime @default(now())

  @@unique([groupId, key])
  @@index([workspaceSlug])
}

model Segment {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  color         String   @default("#5B8DEF")
  // How the rules combine: "all" (AND) or "any" (OR).
  match         String   @default("all")
  rules         Json     @default("[]")
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// Public lead-capture form (opt-in): a submission becomes a Contact.
model Form {
  id             String   @id @default(cuid())
  workspaceSlug  String
  name           String
  // Collected fields: [{ key, label, required }].
  fields         Json     @default("[]")
  // Tags applied to contacts created via this form.
  tags           String[] @default([])
  stage          String   @default("Lead")
  submitLabel    String   @default("Enviar")
  successMessage String   @default("¡Gracias! Te contactaremos pronto.")
  redirectUrl    String?
  views          Int      @default(0)
  submissions    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// A multi-step funnel (opt-in → sales → thank-you). Steps live as JSON.
model Funnel {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  steps         Json     @default("[]")
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// A referral partner in the affiliate program.
model Affiliate {
  id             String   @id @default(cuid())
  workspaceSlug  String
  name           String
  email          String
  code           String   @unique
  commissionPct  Int      @default(20)
  destinationUrl String?
  status         String   @default("active")
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  earnings       Float    @default(0)
  createdAt      DateTime @default(now())

  events AffiliateEvent[]

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// A tracked referral event: a link click or a recorded conversion.
model AffiliateEvent {
  id          String    @id @default(cuid())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  type        String
  amount      Float?
  commission  Float?
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
}

// A drip sequence / autoresponder. Steps live as JSON.
model Sequence {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  status        String   @default("active")
  steps         Json     @default("[]")
  createdAt     DateTime @default(now())

  enrollments SequenceEnrollment[]

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// A contact's progress through a sequence (the drip state machine).
model SequenceEnrollment {
  id            String    @id @default(cuid())
  workspaceSlug String
  sequence      Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceId    String
  contactId     String
  contactName   String
  stepIndex     Int       @default(0)
  status        String    @default("active")
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([sequenceId, contactId])
  // The engine scans active enrollments whose next send is due.
  @@index([status, nextRunAt])
  @@index([sequenceId])
}

model Campaign {
  id                 String         @id @default(cuid())
  workspaceSlug      String
  name               String
  status             CampaignStatus @default(borrador)
  /// Delivery channels: `wa` → WhatsApp target groups; `fb`/`ig` → social publish.
  channels           ChannelId[]
  progress           Int            @default(0)
  nextRunAt          DateTime?
  accent             String?
  /// Message body; supports {{variables}} rendered per target group.
  message            String         @default("")
  /// Schedule: "once" | "daily" | "weekly".
  scheduleType       String         @default("once")
  /// once → ISO datetime; daily/weekly → "HH:MM".
  scheduleAt         String?
  /// daily/weekly → multiple send times per day ["HH:MM", …]. Falls back to
  /// [scheduleAt] when empty (backward compatible).
  scheduleTimes      String[]       @default([])
  /// weekly → days of week (0=Sun … 6=Sat).
  scheduleDays       Int[]
  /// daily/weekly → first and last day it may send ("YYYY-MM-DD", inclusive,
  /// the server's calendar day like the HH:MM times). Null = no limit.
  startDate          String?
  endDate            String?
  /// Uploaded media descriptors [{ path, filename, mime, kind, url }]. First is
  /// used for WhatsApp; all are used for IG carousel.
  attachments        Json           @default("[]")
  /// When true, WhatsApp/Telegram/Status sends rotate through the attachments
  /// (one image per run) instead of always using the first. Great for daily
  /// campaigns that should vary the creative.
  rotateAttachments  Boolean        @default(false)
  /// Cursor for attachment rotation — which image the next run should use.
  attachmentRotation Int            @default(0)
  /// IG publish format: "feed" | "reel" | "story" | "carousel".
  socialFormat       String?
  /// When true, the campaign also publishes to the connected WhatsApp Status
  /// (Estados) via Baileys, in addition to any target groups / social posts.
  postToWaStatus     Boolean        @default(false)
  lastRunAt          DateTime?
  /// Last execution day (YYYY-MM-DD) to dedupe daily/weekly runs.
  lastRunDay         String?
  /// Last executed time-slot ("YYYY-MM-DDTHH:MM") to dedupe multi-time runs.
  lastRunSlot        String?
  /// Run in flight: idempotency key of the current execution ("once:<at>",
  /// "<YYYY-MM-DD>T<HH:MM>" or "manual:<id>"). NULL when no run is in flight.
  /// Lets a run interrupted by a restart be resumed without resending.
  runKey             String?
  /// Heartbeat of the in-flight run; a stale heartbeat means the process died.
  runHeartbeatAt     DateTime?
  /// Price per currency for {{precio}}: { "VES": "350", "COP": "40.000" }.
  prices             Json           @default("{}")
  /// Append the brand's links and the NV Marketing credit to group messages.
  addFooter          Boolean        @default(true)
  /// Category the team files the campaign under («Halloween», «Streaming»…).
  category           String?
  createdAt          DateTime       @default(now())

  posts    Post[]
  targets  CampaignTarget[]
  sendLogs SendLog[]

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

/**
 * Join table: which WhatsApp groups a campaign targets.
 */
model CampaignTarget {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
  createdAt  DateTime @default(now())

  @@unique([campaignId, groupId])
  @@index([groupId])
}

/**
 * Delivery history: one row per group/social send attempt.
 */
model SendLog {
  id            String    @id @default(cuid())
  workspaceSlug String
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaignName  String?
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId       String?
  groupName     String?
  /// "wa" | "facebook" | "instagram".
  target        String?
  /// Social post id returned by the Graph API (for insights lookups).
  postId        String?
  format        String?
  preview       String?
  ok            Boolean   @default(false)
  error         String?
  /// Campaign run this send belongs to (Campaign.runKey). Unique per chat and
  /// run, so a retried or resumed run can never deliver twice to the same chat.
  runKey        String?
  createdAt     DateTime  @default(now())

  @@unique([campaignId, groupId, runKey])
  @@index([workspaceSlug])
  @@index([campaignId])
  @@index([workspaceSlug, createdAt])
}

model Post {
  id               String     @id @default(cuid())
  workspaceSlug    String
  campaign         Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId       String?
  channel          ChannelId
  title            String
  copy             String?
  hashtags         String[]
  /// Uploaded media descriptors [{ path, filename, mime, kind, url }], shared
  /// with the unified content editor's preview. First is the primary visual.
  attachments      Json       @default("[]")
  status           PostStatus @default(draft)
  scheduledAt      DateTime?
  /// When the scheduler claimed the post (status "publishing"); lets the sweep
  /// tell an interrupted publish from one still in flight.
  publishStartedAt DateTime?
  createdAt        DateTime   @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, scheduledAt])
  @@index([status, scheduledAt])
}

model Connection {
  id            String           @id @default(cuid())
  workspaceSlug String
  channel       ChannelId
  handle        String
  status        ConnectionStatus @default(down)
  token         String?
  expiresAt     DateTime?
  webhookStatus String?
  permissions   String[]
  createdAt     DateTime         @default(now())

  @@unique([workspaceSlug, channel])
  @@index([workspaceSlug])
}

// Per-workspace API keys / tokens for integrations (OpenAI, Telegram, ImgBB…),
// entered from the app UI instead of server env vars. `data` is an ENCRYPTED
// JSON blob of that provider's fields (e.g. {"apiKey":"…"} or {"apiId","apiHash"}).
// Read with an env-var fallback, so existing server-configured deployments keep
// working. Never returned to the client in plaintext (only a masked preview).
model IntegrationCredential {
  id            String   @id @default(cuid())
  workspaceSlug String
  provider      String
  data          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, provider])
  @@index([workspaceSlug])
}

model MediaFolder {
  id            String       @id @default(cuid())
  workspaceSlug String
  label         String
  assets        MediaAsset[]

  @@index([workspaceSlug])
}

model MediaAsset {
  id            String       @id @default(cuid())
  workspaceSlug String
  folder        MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId      String?
  type          String
  title         String
  tag           String?
  url           String?
  createdAt     DateTime     @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

model Template {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  category      String
  body          String
  uses          Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

model Automation {
  id            String                   @id @default(cuid())
  workspaceSlug String
  name          String
  status        String                   @default("pausado")
  runs          Int                      @default(0)
  description   String?
  nodes         Json                     @default("[]")
  // Visual-editor connections between nodes (graph edges).
  edges         Json                     @default("[]")
  // Optional n8n webhook (absolute URL or path resolved against N8N_BASE_URL).
  webhookUrl    String?
  createdAt     DateTime                 @default(now())
  waits         AutomationWait[]
  executions    AutomationRun[]
  inactiveFires AutomationInactiveFire[]

  @@index([workspaceSlug])
}

/// One real execution of a flow for one contact (an incoming message, or a
/// resume after a "wait" step), with the steps it took and why any were
/// skipped. Kept 30 days. status: ok | skipped | waiting | error.
model AutomationRun {
  id            String     @id @default(cuid())
  workspaceSlug String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId  String
  /// "message" (incoming message) or "resume" (after a wait).
  trigger       String
  contactHandle String
  contactName   String?
  status        String
  /// AutomationTraceStep[]
  steps         Json       @default("[]")
  error         String?
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  @@index([automationId, startedAt])
  @@index([startedAt])
}

/// A flow paused on a "wait" node for one contact. The runner resumes it from
/// `nextNodeId` once `resumeAt` passes, so waits survive restarts (cPanel has
/// no Redis). status: pending → running → done | failed | cancelled.
model AutomationWait {
  id            String     @id @default(cuid())
  workspaceSlug String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId  String
  /// The wait node that paused the flow (dedupes one pending wait per contact).
  waitNodeId    String
  nextNodeId    String
  contactHandle String
  /// Incoming message + evaluated context needed to continue the flow.
  payload       Json
  resumeAt      DateTime
  status        String     @default("pending")
  startedAt     DateTime?
  error         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, resumeAt])
  @@index([automationId, contactHandle, status])
  @@index([workspaceSlug])
}

/// A "contact inactive N days" flow already ran for this contact's current
/// quiet spell (the lastContactAt it saw). It runs again only after the contact
/// writes again and goes quiet again.
model AutomationInactiveFire {
  id            String     @id @default(cuid())
  workspaceSlug String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId  String
  contactId     String
  lastContactAt DateTime
  firedAt       DateTime   @default(now())

  @@unique([automationId, contactId])
  @@index([workspaceSlug])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  workspaceSlug String
  channel       ChannelId
  title         String
  date          DateTime
  campaignId    String?

  @@index([workspaceSlug])
  @@index([workspaceSlug, date])
}

model Conversation {
  id            String    @id @default(cuid())
  workspaceSlug String
  channel       ChannelId
  contactName   String
  // Recipient address for outbound delivery: WhatsApp phone (E.164) or Telegram chat id.
  contactHandle String?
  resolved      Boolean   @default(false)
  assignee      String?
  /// Free-form labels for triage (e.g. "ventas", "urgente").
  labels        String[]
  /// New incoming messages not seen yet; 0 when read, ≥1 to mark it unread again.
  unreadCount   Int       @default(0)
  /// WhatsApp number (line) the chat belongs to; replies go out from it.
  waLine        Int?
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  direction      String
  text           String
  /// Platform message id (WhatsApp), so a message replayed by the session is stored once.
  externalId     String?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, externalId])
  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Notification {
  id            String   @id @default(cuid())
  workspaceSlug String
  type          String   @default("info")
  title         String
  meta          String?
  /// Email of the one member it is for; null = whole workspace.
  recipient     String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  workspaceSlug String
  actor         String
  action        String
  target        String?
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

/**
 * User-created workspaces, stored alongside the 14 built-in (config) ones.
 */
model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  kind      String   @default("creative")
  accent    String   @default("#5B8DEF")
  tagline   String?
  createdBy String
  createdAt DateTime @default(now())
}

/// Free trial and paid time of a self-serve brand. Only brands created by a
/// customer have a row; built-in brands and the operator's own have none and are
/// never locked.
model WorkspaceAccess {
  workspaceSlug String    @id
  trialEndsAt   DateTime
  /// Paid access runs until this moment (extended each time a payment is confirmed).
  paidUntil     DateTime?
  /// Paid plan («basico» | «pro»); null = still on the trial (or paid before plans existed → pro).
  planId        String?
  activatedBy   String?
  /// When the trial's one campaign send was used (null = still free to send).
  trialSendAt   DateTime?
  /// No trial was given: the device or account already had one.
  trialDenied   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Who got a free trial, from which device. Kept when the brand is deleted
/// (no workspaceSlug column on purpose) so deleting and recreating a brand,
/// or opening another account on the same device, does not give a new trial.
/// Device id and fingerprint are stored hashed.
model TrialClaim {
  id              String   @id @default(cuid())
  brandSlug       String
  userId          String
  deviceHash      String?
  fingerprintHash String?
  ip              String?
  granted         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([deviceHash])
  @@index([fingerprintHash, ip])
}

/// Per-brand settings that apply to built-in and created workspaces alike
/// (built-in ones have no Workspace row). One row per workspace, created on first save.
model WorkspaceSettings {
  workspaceSlug String   @id
  /// IANA zone the weekly report cuts weeks in (Monday 00:00 local).
  timeZone      String   @default("UTC")
  /// Brand links for the campaign footer: [{ label, url }].
  socialLinks   Json     @default("[]")
  website       String?
  /// What the brand wants to achieve first (onboarding «¿Qué quieres lograr
  /// primero?»); orders the sidebar and the dashboard's next steps.
  goals         String[] @default([])
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}

/**
 * Connected Google account for a workspace (Calendar/Drive OAuth).
 */
model GoogleConnection {
  id            String    @id @default(cuid())
  workspaceSlug String    @unique
  email         String?
  // NOTE: tokens are stored as-is for this scaffold; encrypt at rest in production.
  accessToken   String
  refreshToken  String?
  scope         String?
  expiresAt     DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

/**
 * WhatsApp (Baileys) connection metadata per workspace; creds live on disk.
 */
/// One linked WhatsApp number of a brand. Line 1 is the main number; a brand
/// can link more (line 2, 3…), each with its own QR and session files.
model WhatsappSession {
  id               String    @id @default(cuid())
  workspaceSlug    String
  line             Int       @default(1)
  /// Name the user gives the number («Ventas», «Soporte»).
  label            String?
  status           String    @default("disconnected")
  number           String?
  lastConnectionAt DateTime?
  groupsCount      Int       @default(0)
  contactsCount    Int       @default(0)
  updatedAt        DateTime  @updatedAt

  @@unique([workspaceSlug, line])
}

/// Telegram user (MTProto/GramJS) session state per workspace. The auth string
/// itself lives on disk (TELEGRAM_SESSION_DIR), not here.
model TelegramSession {
  id               String    @id @default(cuid())
  workspaceSlug    String    @unique
  status           String    @default("disconnected")
  username         String?
  phone            String?
  lastConnectionAt DateTime?
  groupsCount      Int       @default(0)
  updatedAt        DateTime  @updatedAt
}

/**
 * Async job managed by the Job Manager: state, attempts, retries and failures
 * for work processed through the Queue Manager (BullMQ/Redis, or inline).
 */
model Job {
  id            String   @id @default(cuid())
  workspaceSlug String
  type          String
  status        String   @default("queued") // queued | active | completed | failed
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  payload       Json
  result        Json?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceSlug, status])
  @@index([type, status])
}

/**
 * Active adapter chosen per provider, per workspace (Provider + Adapter
 * pattern). e.g. provider "whatsapp" → adapter "baileys" | "cloud-api".
 * When no row exists the provider falls back to its default adapter.
 */
model ProviderSelection {
  id            String   @id @default(cuid())
  workspaceSlug String
  provider      String
  adapter       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, provider])
}

/**
 * AI usage aggregated per workspace and month (YYYY-MM) for metering/quotas.
 */
model AiUsage {
  id            String   @id @default(cuid())
  workspaceSlug String
  period        String
  calls         Int      @default(0)
  tokens        Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, period])
}

/**
 * Stripe billing state, one per workspace.
 */
model BillingAccount {
  id                 String   @id @default(cuid())
  workspaceSlug      String   @unique
  stripeCustomerId   String?
  subscriptionId     String?
  subscriptionStatus String?
  priceId            String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

/**
 * Campaign Builder creative — a layered visual design (Canva-like), stored as a
 * JSON layer list plus its canvas format. Reusable across posts/campaigns.
 */
model Design {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  format        String   @default("square")
  layers        Json     @default("[]")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, updatedAt])
}

/**
 * CRM activity: a timestamped note on a contact (manual log / call summary).
 */
model ContactNote {
  id            String   @id @default(cuid())
  workspaceSlug String
  contactId     String
  body          String
  author        String
  createdAt     DateTime @default(now())

  @@index([workspaceSlug, contactId])
}

/**
 * Per-user onboarding state for a workspace. Step completion is derived from
 * live workspace data; this row only persists the user's choice to dismiss the
 * guided checklist (works for both built-in and DB workspaces).
 */
model OnboardingState {
  id            String    @id @default(cuid())
  workspaceSlug String
  userId        String
  dismissedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([workspaceSlug, userId])
  @@index([workspaceSlug])
}

/**
 * Per-user changelog state. The changelog is product-wide (not workspace
 * scoped), so this is keyed by user only; `lastSeenAt` drives the "unseen" badge.
 */
model ChangelogState {
  id         String   @id @default(cuid())
  userId     String   @unique
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/**
 * In-app feedback submitted by workspace members (idea / bug / question…).
 * Captured for the product team; not surfaced back to the workspace.
 */
model Feedback {
  id            String   @id @default(cuid())
  workspaceSlug String
  userId        String
  author        String
  type          String
  rating        Int?
  message       String
  createdAt     DateTime @default(now())

  @@index([workspaceSlug, createdAt])
}

/**
 * Pending invitation to join a workspace for an email that has no account yet.
 * When that email registers, the membership is granted automatically (see
 * AuthService.register). Existing users are added directly, without an
 * Invitation row.
 */
model Invitation {
  id            String    @id @default(cuid())
  workspaceSlug String
  email         String
  role          String    @default("Editor")
  token         String    @unique
  invitedByName String?
  acceptedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@unique([workspaceSlug, email])
  @@index([workspaceSlug])
  @@index([email])
}

/// A shareable link that lets anyone with it join a workspace with a fixed role
/// (never Owner). Only the hash of the token is stored; the link is shown once.
model InviteLink {
  id            String    @id @default(cuid())
  workspaceSlug String
  tokenHash     String    @unique
  role          String    @default("Visor")
  createdByName String?
  maxUses       Int?
  uses          Int       @default(0)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([workspaceSlug])
}

/// A team to-do on the workspace task board. status: todo | doing | done;
/// priority: low | normal | high. `position` orders cards within a column.
model Task {
  id            String    @id @default(cuid())
  workspaceSlug String
  title         String
  description   String    @default("")
  status        String    @default("todo")
  priority      String    @default("normal")
  /// Email of the assigned workspace member.
  assignee      String?
  dueAt         DateTime?
  position      Float     @default(0)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
  /// CRM contact this task is about (same workspace; ignored once that contact is deleted).
  contactId     String?

  @@index([workspaceSlug, status, position])
  @@index([workspaceSlug, contactId])
}

/// Frozen summary of one closed week (Monday UTC), generated once per
/// workspace and kept as history. `data` holds metrics, lead sources and the
/// "needs attention" list (see WeeklyReport in @nv/domain).
model WeeklyReport {
  id            String   @id @default(cuid())
  workspaceSlug String
  /// Monday 00:00 UTC that starts the week.
  weekStart     DateTime
  data          Json
  createdAt     DateTime @default(now())

  @@unique([workspaceSlug, weekStart])
}

/// A way a brand gets paid (Nequi, Pago Móvil, Yape, Binance Pay, Zinli…).
/// Details are what customers need to pay; they are not credentials.
model PaymentMethod {
  id            String   @id @default(cuid())
  workspaceSlug String
  kind          String
  label         String
  currency      String
  details       Json     @default("{}")
  instructions  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
}

/// A charge to a customer. Confirmed by hand (status "pagado") once the team
/// sees the money in its own account; the app never moves funds.
model PaymentRequest {
  id            String    @id @default(cuid())
  workspaceSlug String
  concept       String
  amount        Decimal   @db.Decimal(18, 2)
  currency      String
  status        String    @default("pendiente")
  contactId     String?
  methodId      String?
  /// Method name when it was used, kept if the method is later deleted.
  methodLabel   String?
  reference     String?
  note          String?
  rejectReason  String?
  dueAt         DateTime?
  paidAt        DateTime?
  verifiedBy    String?
  createdBy     String
  /// Plan payment of a customer brand (set only in the operator's billing
  /// brand); confirming it as "pagado" adds paid days to that brand.
  forWorkspace  String?
  /// Plan the brand pays for (plan payments only).
  planId        String?
  /// Payer details the customer typed (name, bank, phone, date…), plan payments only.
  payer         Json?
  /// Receipt file name in the private receipts folder (never served publicly).
  receiptFile   String?
  receiptType   String?
  /// Amount in the method's own money (e.g. VES) and the USDT rate used.
  localAmount   Decimal?  @db.Decimal(18, 2)
  localCurrency String?
  rate          Decimal?  @db.Decimal(18, 4)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceSlug, status, createdAt])
  @@index([workspaceSlug, contactId])
  @@index([forWorkspace, createdAt])
}

/// A product or service in the brand's Tienda (catalog). Prices are per
/// currency, typed by the user (never converted).
model Product {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  description   String?
  category      String?
  /// currency → amount text, e.g. { "VES": "350", "USD": "10" }.
  prices        Json     @default("{}")
  /// Uploaded images [{ path, filename, mime, kind, url }]; first is the cover.
  images        Json     @default("[]")
  sku           String?
  /// null = not tracked.
  stock         Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceSlug])
}
