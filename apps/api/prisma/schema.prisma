// NV Core — data model (PostgreSQL).
//
// Multi-tenant by slug: workspaces are configuration (see @nv/domain), so every
// operational row carries `workspaceSlug` (indexed) rather than a Workspace FK.
// Identity (User/Membership) is persisted here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelId {
  wa
  ig
  fb
  tk
  tg
  x
  th
  email
}

enum CampaignStatus {
  borrador
  programada
  activa
  pausada
  completada
}

enum PostStatus {
  draft
  scheduled
  publishing
  sent
  error
}

enum ConnectionStatus {
  ok
  warn
  down
}

enum Role {
  Owner
  Admin
  Editor
  Visor
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// sha256 hash of the opaque refresh token (never stored in clear).
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Membership {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  workspaceSlug String
  role          Role     @default(Visor)
  createdAt     DateTime @default(now())

  @@unique([userId, workspaceSlug])
  @@index([workspaceSlug])
}

model Contact {
  id            String    @id @default(cuid())
  workspaceSlug String
  name          String
  phone         String?
  email         String?
  company       String?
  tags          String[]
  stage         String    @default("Lead")
  lastContactAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([workspaceSlug])
}

model Group {
  id            String    @id @default(cuid())
  workspaceSlug String
  name          String
  channel       ChannelId @default(wa)
  members       Int       @default(0)
  admins        Int       @default(0)
  description   String?
  tags          String[]
  createdAt     DateTime  @default(now())

  @@index([workspaceSlug])
}

model Segment {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  color         String   @default("#5B8DEF")
  rules         Json     @default("[]")
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
}

model Campaign {
  id            String         @id @default(cuid())
  workspaceSlug String
  name          String
  status        CampaignStatus @default(borrador)
  channels      ChannelId[]
  progress      Int            @default(0)
  nextRunAt     DateTime?
  accent        String?
  createdAt     DateTime       @default(now())
  posts         Post[]

  @@index([workspaceSlug])
}

model Post {
  id            String     @id @default(cuid())
  workspaceSlug String
  campaign      Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId    String?
  channel       ChannelId
  title         String
  copy          String?
  hashtags      String[]
  status        PostStatus @default(draft)
  scheduledAt   DateTime?
  createdAt     DateTime   @default(now())

  @@index([workspaceSlug])
}

model Connection {
  id            String           @id @default(cuid())
  workspaceSlug String
  channel       ChannelId
  handle        String
  status        ConnectionStatus @default(down)
  token         String?
  expiresAt     DateTime?
  webhookStatus String?
  permissions   String[]
  createdAt     DateTime         @default(now())

  @@unique([workspaceSlug, channel])
  @@index([workspaceSlug])
}

model MediaFolder {
  id            String       @id @default(cuid())
  workspaceSlug String
  label         String
  assets        MediaAsset[]

  @@index([workspaceSlug])
}

model MediaAsset {
  id            String       @id @default(cuid())
  workspaceSlug String
  folder        MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId      String?
  type          String
  title         String
  tag           String?
  url           String?
  createdAt     DateTime     @default(now())

  @@index([workspaceSlug])
}

model Template {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  category      String
  body          String
  uses          Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
}

model Automation {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  status        String   @default("pausado")
  runs          Int      @default(0)
  description   String?
  nodes         Json     @default("[]")
  // Optional n8n webhook (absolute URL or path resolved against N8N_BASE_URL).
  webhookUrl    String?
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  workspaceSlug String
  channel       ChannelId
  title         String
  date          DateTime
  campaignId    String?

  @@index([workspaceSlug])
}

model Conversation {
  id            String    @id @default(cuid())
  workspaceSlug String
  channel       ChannelId
  contactName   String
  // Recipient address for outbound delivery: WhatsApp phone (E.164) or Telegram chat id.
  contactHandle String?
  resolved      Boolean   @default(false)
  assignee      String?
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@index([workspaceSlug])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  direction      String
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Notification {
  id            String   @id @default(cuid())
  workspaceSlug String
  type          String   @default("info")
  title         String
  meta          String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
}

model AuditLog {
  id            String   @id @default(cuid())
  workspaceSlug String
  actor         String
  action        String
  target        String?
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
}

/** User-created workspaces, stored alongside the 14 built-in (config) ones. */
model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  kind      String   @default("creative")
  accent    String   @default("#5B8DEF")
  tagline   String?
  createdBy String
  createdAt DateTime @default(now())
}

/** Connected Google account for a workspace (Calendar/Drive OAuth). */
model GoogleConnection {
  id            String   @id @default(cuid())
  workspaceSlug String   @unique
  email         String?
  // NOTE: tokens are stored as-is for this scaffold; encrypt at rest in production.
  accessToken   String
  refreshToken  String?
  scope         String?
  expiresAt     DateTime?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

/** Stripe billing state, one per workspace. */
model BillingAccount {
  id                 String   @id @default(cuid())
  workspaceSlug      String   @unique
  stripeCustomerId   String?
  subscriptionId     String?
  subscriptionStatus String?
  priceId            String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}
