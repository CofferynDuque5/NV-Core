// NV Core — data model (PostgreSQL).
//
// Multi-tenant by slug: workspaces are configuration (see @nv/domain), so every
// operational row carries `workspaceSlug` (indexed) rather than a Workspace FK.
// Identity (User/Membership) is persisted here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelId {
  wa
  ig
  fb
  tk
  tg
  x
  th
  email
}

enum CampaignStatus {
  borrador
  programada
  activa
  pausada
  completada
}

enum PostStatus {
  draft
  scheduled
  publishing
  sent
  error
}

enum ConnectionStatus {
  ok
  warn
  down
}

enum Role {
  Owner
  Admin
  Editor
  Visor
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String
  passwordHash        String
  emailVerifiedAt     DateTime?
  /// Consecutive failed logins; reset to 0 on success. Drives account lockout.
  failedLoginAttempts Int            @default(0)
  /// When set and in the future, logins are refused (brute-force lockout).
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  memberships         Membership[]
  refreshTokens       RefreshToken[]
  authTokens          AuthToken[]
}

/**
 * Single-use tokens for password reset ("reset") and email verification ("verify").
 */
model AuthToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  purpose   String
  /// sha256 hash of the opaque token (never stored in clear).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// sha256 hash of the opaque refresh token (never stored in clear).
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Membership {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  workspaceSlug String
  role          Role     @default(Visor)
  createdAt     DateTime @default(now())

  @@unique([userId, workspaceSlug])
  @@index([workspaceSlug])
}

model Contact {
  id            String    @id @default(cuid())
  workspaceSlug String
  name          String
  phone         String?
  email         String?
  company       String?
  tags          String[]
  stage         String    @default("Lead")
  lastContactAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

model Group {
  id            String    @id @default(cuid())
  workspaceSlug String
  name          String
  channel       ChannelId @default(wa)
  members       Int       @default(0)
  admins        Int       @default(0)
  description   String?
  tags          String[]
  /// WhatsApp group JID (e.g. "12345-678@g.us") when synced from Baileys.
  remoteJid     String?
  /// True when the row was populated from a WhatsApp sync (vs. manual CRUD).
  synced        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  variables       GroupVariable[]
  campaignTargets CampaignTarget[]
  sendLogs        SendLog[]

  @@unique([workspaceSlug, remoteJid])
  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

/**
 * Per-group merge variables: {{key}} → value when rendering campaign messages.
 */
model GroupVariable {
  id            String   @id @default(cuid())
  workspaceSlug String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String
  key           String
  value         String   @default("")
  createdAt     DateTime @default(now())

  @@unique([groupId, key])
  @@index([workspaceSlug])
}

model Segment {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  color         String   @default("#5B8DEF")
  // How the rules combine: "all" (AND) or "any" (OR).
  match         String   @default("all")
  rules         Json     @default("[]")
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// Public lead-capture form (opt-in): a submission becomes a Contact.
model Form {
  id             String   @id @default(cuid())
  workspaceSlug  String
  name           String
  // Collected fields: [{ key, label, required }].
  fields         Json     @default("[]")
  // Tags applied to contacts created via this form.
  tags           String[] @default([])
  stage          String   @default("Lead")
  submitLabel    String   @default("Enviar")
  successMessage String   @default("¡Gracias! Te contactaremos pronto.")
  redirectUrl    String?
  views          Int      @default(0)
  submissions    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// A multi-step funnel (opt-in → sales → thank-you). Steps live as JSON.
model Funnel {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  steps         Json     @default("[]")
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// A referral partner in the affiliate program.
model Affiliate {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  email         String
  code          String   @unique
  commissionPct Int      @default(20)
  destinationUrl String?
  status        String   @default("active")
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  earnings      Float    @default(0)
  createdAt     DateTime @default(now())

  events        AffiliateEvent[]

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// A tracked referral event: a link click or a recorded conversion.
model AffiliateEvent {
  id          String    @id @default(cuid())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  type        String
  amount      Float?
  commission  Float?
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
}

// A drip sequence / autoresponder. Steps live as JSON.
model Sequence {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  status        String   @default("active")
  steps         Json     @default("[]")
  createdAt     DateTime @default(now())

  enrollments   SequenceEnrollment[]

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

// A contact's progress through a sequence (the drip state machine).
model SequenceEnrollment {
  id            String    @id @default(cuid())
  workspaceSlug String
  sequence      Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceId    String
  contactId     String
  contactName   String
  stepIndex     Int       @default(0)
  status        String    @default("active")
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([sequenceId, contactId])
  // The engine scans active enrollments whose next send is due.
  @@index([status, nextRunAt])
  @@index([sequenceId])
}

model Campaign {
  id            String         @id @default(cuid())
  workspaceSlug String
  name          String
  status        CampaignStatus @default(borrador)
  /// Delivery channels: `wa` → WhatsApp target groups; `fb`/`ig` → social publish.
  channels      ChannelId[]
  progress      Int            @default(0)
  nextRunAt     DateTime?
  accent        String?
  /// Message body; supports {{variables}} rendered per target group.
  message       String         @default("")
  /// Schedule: "once" | "daily" | "weekly".
  scheduleType  String         @default("once")
  /// once → ISO datetime; daily/weekly → "HH:MM".
  scheduleAt    String?
  /// daily/weekly → multiple send times per day ["HH:MM", …]. Falls back to
  /// [scheduleAt] when empty (backward compatible).
  scheduleTimes String[]       @default([])
  /// weekly → days of week (0=Sun … 6=Sat).
  scheduleDays  Int[]
  /// Uploaded media descriptors [{ path, filename, mime, kind, url }]. First is
  /// used for WhatsApp; all are used for IG carousel.
  attachments   Json           @default("[]")
  /// IG publish format: "feed" | "reel" | "story" | "carousel".
  socialFormat  String?
  lastRunAt     DateTime?
  /// Last execution day (YYYY-MM-DD) to dedupe daily/weekly runs.
  lastRunDay    String?
  /// Last executed time-slot ("YYYY-MM-DDTHH:MM") to dedupe multi-time runs.
  lastRunSlot   String?
  createdAt     DateTime       @default(now())

  posts    Post[]
  targets  CampaignTarget[]
  sendLogs SendLog[]

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

/**
 * Join table: which WhatsApp groups a campaign targets.
 */
model CampaignTarget {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
  createdAt  DateTime @default(now())

  @@unique([campaignId, groupId])
  @@index([groupId])
}

/**
 * Delivery history: one row per group/social send attempt.
 */
model SendLog {
  id            String    @id @default(cuid())
  workspaceSlug String
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaignName  String?
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId       String?
  groupName     String?
  /// "wa" | "facebook" | "instagram".
  target        String?
  /// Social post id returned by the Graph API (for insights lookups).
  postId        String?
  format        String?
  preview       String?
  ok            Boolean   @default(false)
  error         String?
  createdAt     DateTime  @default(now())

  @@index([workspaceSlug])
  @@index([campaignId])
  @@index([workspaceSlug, createdAt])
}

model Post {
  id            String     @id @default(cuid())
  workspaceSlug String
  campaign      Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId    String?
  channel       ChannelId
  title         String
  copy          String?
  hashtags      String[]
  status        PostStatus @default(draft)
  scheduledAt   DateTime?
  createdAt     DateTime   @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, scheduledAt])
}

model Connection {
  id            String           @id @default(cuid())
  workspaceSlug String
  channel       ChannelId
  handle        String
  status        ConnectionStatus @default(down)
  token         String?
  expiresAt     DateTime?
  webhookStatus String?
  permissions   String[]
  createdAt     DateTime         @default(now())

  @@unique([workspaceSlug, channel])
  @@index([workspaceSlug])
}

model MediaFolder {
  id            String       @id @default(cuid())
  workspaceSlug String
  label         String
  assets        MediaAsset[]

  @@index([workspaceSlug])
}

model MediaAsset {
  id            String       @id @default(cuid())
  workspaceSlug String
  folder        MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId      String?
  type          String
  title         String
  tag           String?
  url           String?
  createdAt     DateTime     @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

model Template {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  category      String
  body          String
  uses          Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

model Automation {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  status        String   @default("pausado")
  runs          Int      @default(0)
  description   String?
  nodes         Json     @default("[]")
  // Visual-editor connections between nodes (graph edges).
  edges         Json     @default("[]")
  // Optional n8n webhook (absolute URL or path resolved against N8N_BASE_URL).
  webhookUrl    String?
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  workspaceSlug String
  channel       ChannelId
  title         String
  date          DateTime
  campaignId    String?

  @@index([workspaceSlug])
  @@index([workspaceSlug, date])
}

model Conversation {
  id            String    @id @default(cuid())
  workspaceSlug String
  channel       ChannelId
  contactName   String
  // Recipient address for outbound delivery: WhatsApp phone (E.164) or Telegram chat id.
  contactHandle String?
  resolved      Boolean   @default(false)
  assignee      String?
  /// Free-form labels for triage (e.g. "ventas", "urgente").
  labels        String[]
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  direction      String
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Notification {
  id            String   @id @default(cuid())
  workspaceSlug String
  type          String   @default("info")
  title         String
  meta          String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  workspaceSlug String
  actor         String
  action        String
  target        String?
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, createdAt])
}

/**
 * User-created workspaces, stored alongside the 14 built-in (config) ones.
 */
model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  kind      String   @default("creative")
  accent    String   @default("#5B8DEF")
  tagline   String?
  createdBy String
  createdAt DateTime @default(now())
}

/**
 * Connected Google account for a workspace (Calendar/Drive OAuth).
 */
model GoogleConnection {
  id            String    @id @default(cuid())
  workspaceSlug String    @unique
  email         String?
  // NOTE: tokens are stored as-is for this scaffold; encrypt at rest in production.
  accessToken   String
  refreshToken  String?
  scope         String?
  expiresAt     DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

/**
 * WhatsApp (Baileys) connection metadata per workspace; creds live on disk.
 */
model WhatsappSession {
  id               String    @id @default(cuid())
  workspaceSlug    String    @unique
  status           String    @default("disconnected")
  number           String?
  lastConnectionAt DateTime?
  groupsCount      Int       @default(0)
  contactsCount    Int       @default(0)
  updatedAt        DateTime  @updatedAt
}

/**
 * Async job managed by the Job Manager: state, attempts, retries and failures
 * for work processed through the Queue Manager (BullMQ/Redis, or inline).
 */
model Job {
  id            String   @id @default(cuid())
  workspaceSlug String
  type          String
  status        String   @default("queued") // queued | active | completed | failed
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  payload       Json
  result        Json?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceSlug, status])
  @@index([type, status])
}

/**
 * Active adapter chosen per provider, per workspace (Provider + Adapter
 * pattern). e.g. provider "whatsapp" → adapter "baileys" | "cloud-api".
 * When no row exists the provider falls back to its default adapter.
 */
model ProviderSelection {
  id            String   @id @default(cuid())
  workspaceSlug String
  provider      String
  adapter       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, provider])
}

/**
 * AI usage aggregated per workspace and month (YYYY-MM) for metering/quotas.
 */
model AiUsage {
  id            String   @id @default(cuid())
  workspaceSlug String
  period        String
  calls         Int      @default(0)
  tokens        Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, period])
}

/**
 * Stripe billing state, one per workspace.
 */
model BillingAccount {
  id                 String   @id @default(cuid())
  workspaceSlug      String   @unique
  stripeCustomerId   String?
  subscriptionId     String?
  subscriptionStatus String?
  priceId            String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

/**
 * Campaign Builder creative — a layered visual design (Canva-like), stored as a
 * JSON layer list plus its canvas format. Reusable across posts/campaigns.
 */
model Design {
  id            String   @id @default(cuid())
  workspaceSlug String
  name          String
  format        String   @default("square")
  layers        Json     @default("[]")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
  @@index([workspaceSlug, updatedAt])
}

/**
 * CRM activity: a timestamped note on a contact (manual log / call summary).
 */
model ContactNote {
  id            String   @id @default(cuid())
  workspaceSlug String
  contactId     String
  body          String
  author        String
  createdAt     DateTime @default(now())

  @@index([workspaceSlug, contactId])
}


/**
 * Per-user onboarding state for a workspace. Step completion is derived from
 * live workspace data; this row only persists the user's choice to dismiss the
 * guided checklist (works for both built-in and DB workspaces).
 */
model OnboardingState {
  id            String    @id @default(cuid())
  workspaceSlug String
  userId        String
  dismissedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([workspaceSlug, userId])
  @@index([workspaceSlug])
}

/**
 * Per-user changelog state. The changelog is product-wide (not workspace
 * scoped), so this is keyed by user only; `lastSeenAt` drives the "unseen" badge.
 */
model ChangelogState {
  id         String   @id @default(cuid())
  userId     String   @unique
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/**
 * In-app feedback submitted by workspace members (idea / bug / question…).
 * Captured for the product team; not surfaced back to the workspace.
 */
model Feedback {
  id            String   @id @default(cuid())
  workspaceSlug String
  userId        String
  author        String
  type          String
  rating        Int?
  message       String
  createdAt     DateTime @default(now())

  @@index([workspaceSlug, createdAt])
}
