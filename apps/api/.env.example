# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Public base URLs (OAuth redirect URIs + post-callback redirects)
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Required in production. Min 16 chars. Dev falls back to an insecure default.
# JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (short); refresh tokens (httpOnly cookie) extend the session.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# Clave para cifrar secretos en reposo (tokens OAuth, etc.). Obligatoria en producción.
# ENCRYPTION_KEY=change-me-to-a-long-random-string

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# When unset, the API runs without a DB and every endpoint returns empty results.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nvcore?schema=public

# ── Observabilidad (Sentry) ──────────────────────────────────────────────────
# Con SENTRY_DSN, los errores 5xx se reportan a Sentry. Sin él, es no-op.
# SENTRY_DSN=

# ── Cache / queues (Redis) ───────────────────────────────────────────────────
# Con REDIS_URL se activa el worker (BullMQ) que publica los posts programados
# en su fecha. Sin él, los posts quedan en estado "scheduled" sin publicarse.
# REDIS_URL=redis://localhost:6379

# ── Automation (n8n) ─────────────────────────────────────────────────────────
# Con N8N_BASE_URL, "Ejecutar" en Automatizaciones llama al webhook de n8n
# (una automatización puede guardar una URL absoluta o un path relativo a esta base).
# N8N_BASE_URL=http://localhost:5678
# N8N_API_KEY=

# ── AI providers ─────────────────────────────────────────────────────────────
# Configure at least one to enable AI Content Studio. When several are set the
# API picks AI_PROVIDER, or falls back in priority order: anthropic → openai → gemini.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_PROVIDER=anthropic            # optional: openai | anthropic | gemini
# AI_MONTHLY_QUOTA=1000            # tope mensual de llamadas de IA por workspace (0/vacío = ilimitado)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-1.5-flash

# ── Messaging ────────────────────────────────────────────────────────────────
# Salientes (Inbox → destinatario) y ENTRANTES (webhooks → Inbox).
# Webhooks a registrar:
#   WhatsApp: {API_URL}/api/integrations/whatsapp/webhook  (verify token abajo)
#   Telegram: setWebhook → {API_URL}/api/integrations/telegram/webhook
# INBOUND_WORKSPACE = slug del workspace que recibe los mensajes entrantes.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# META_APP_ID=
# META_APP_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Telegram por CUENTA (login con QR, MTProto/GramJS): importa todos tus grupos y
# canales y envía como tu usuario. API_ID/API_HASH son gratis en my.telegram.org.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# Carpeta donde se guarda la sesión de Telegram (por workspace).
# TELEGRAM_SESSION_DIR=data/telegram
# INBOUND_WORKSPACE=
# WhatsApp por Baileys (QR en el panel): carpeta donde se guarda la sesión.
# WHATSAPP_SESSION_DIR=data/whatsapp

# ── Google APIs ──────────────────────────────────────────────────────────────
# OAuth para conectar Google (Calendar/Drive) desde Conexiones.
# Redirect URI autorizado en Google Console: {API_URL}/api/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# With STRIPE_SECRET_KEY, Configuración → Facturación habilita checkout y portal.
# El webhook (obligatorio para sincronizar la suscripción) va a:
#   {API_URL}/api/integrations/stripe/webhook   → copia su firmante aquí:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=price_...   # precio de suscripción por defecto para el checkout

# ── Media (Cloudinary) ───────────────────────────────────────────────────────
# CLOUDINARY_URL=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Optional. Con RESEND_API_KEY se envían: invitaciones, verificación de email y
# restablecimiento de contraseña (usan APP_URL para construir los enlaces).
# RESEND_API_KEY=
# MAIL_FROM=NV Core <onboarding@resend.dev>
