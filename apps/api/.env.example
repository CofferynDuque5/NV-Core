# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Required in production. Min 16 chars. Dev falls back to an insecure default.
# JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# When unset, the API runs without a DB and every endpoint returns empty results.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nvcore?schema=public

# ── Cache / queues (Redis) ───────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Automation (n8n) ─────────────────────────────────────────────────────────
# N8N_BASE_URL=http://localhost:5678
# N8N_API_KEY=

# ── AI providers ─────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── Messaging ────────────────────────────────────────────────────────────────
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# META_APP_ID=
# META_APP_SECRET=
# TELEGRAM_BOT_TOKEN=

# ── Google APIs ──────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Media (Cloudinary) ───────────────────────────────────────────────────────
# CLOUDINARY_URL=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# RESEND_API_KEY=
