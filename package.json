{
  "name": "nv-core",
  "version": "1.0.0",
  "private": true,
  "description": "NV Core — Business Operating System multi-workspace",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "arrancar": "node scripts/arrancar.mjs",
    "start:all": "node scripts/arrancar.mjs",
    "admin": "node scripts/hazme-admin.mjs",
    "studio": "pnpm --filter @nv/api exec prisma studio",
    "seed": "pnpm --filter @nv/api exec node prisma/seed-examples.cjs",
    "fb": "node scripts/conectar-fb.mjs",
    "tg": "node scripts/conectar-tg.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
